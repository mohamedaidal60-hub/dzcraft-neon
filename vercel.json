{
    "framework": "vite",
    "rewrites": [
        {
            "source": "/api/products",
            "destination": "/api/products.ts"
        },
        {
            "source": "/api/categories",
            "destination": "/api/categories.ts"
        },
        {
            "source": "/api/run-seed",
            "destination": "/api/run-seed.ts"
        },
        {
            "source": "/api/count",
            "destination": "/api/count.ts"
        },
        {
            "source": "/api/debug",
            "destination": "/api/debug.ts"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index.ts"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}