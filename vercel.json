{
    "framework": "vite",
    "rewrites": [
        {
            "source": "/api/history",
            "destination": "/api/history.ts"
        },
        {
            "source": "/api/settings",
            "destination": "/api/settings.ts"
        },
        {
            "source": "/api/products",
            "destination": "/api/products.ts"
        },
        {
            "source": "/api/products/:id",
            "destination": "/api/products/[id].ts"
        },
        {
            "source": "/api/clean-db",
            "destination": "/api/clean-db.ts"
        },
        {
            "source": "/api/categories",
            "destination": "/api/categories.ts"
        },
        {
            "source": "/api/run-seed",
            "destination": "/api/run-seed.ts"
        },
        {
            "source": "/api/count",
            "destination": "/api/count.ts"
        },
        {
            "source": "/api/debug",
            "destination": "/api/debug.ts"
        },
        {
            "source": "/api/migrate-db",
            "destination": "/api/migrate-db.ts"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index.ts"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}